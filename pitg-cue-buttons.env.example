# Copy to /etc/default/pitg-cue-buttons to override defaults.
# Two-button PerfectCue bridge:
# -N next button GPIO input
# -P prev button GPIO input
# -T PerfectCue TX GPIO output
# -B baud
# -D debounce ms
# -c gpiochip index
# -H active-high buttons (omit for active-low)

PITG_CUE_BUTTONS_OPTS="-N 23 -P 24 -T 18 -B 19200 -D 120 -c 0"
