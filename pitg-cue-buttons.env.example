# Copy to /etc/default/pitg-cue-buttons to override defaults.
# Two-button PerfectCue RS-485 bridge (hardware UART):
# -N next button GPIO input (GPIO23 / physical pin 16)
# -P prev button GPIO input (GPIO24 / physical pin 18)
# -S serial device for RS-485 TX
# -B baud
# -D debounce ms
# -c gpiochip index
# -H active-high buttons (omit for active-low / contact-to-GND)
# -T test mode: auto-fire next/prev every 10s at boot

PITG_CUE_BUTTONS_OPTS="-N 23 -P 24 -S /dev/ttyRS485 -B 19200 -D 120 -c 0 -T"
