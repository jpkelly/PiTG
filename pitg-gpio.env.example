# Copy to /etc/default/pitg-gpio to override defaults.
# Keep pitg-gpio in Limitimer-only mode for the split harness.
# PerfectCue test mode belongs on pitg-cue-buttons, not here.
#
# -t  countdown total time (MM:SS or seconds)  e.g. 10:00 = 10 minutes
# -o  overtime count-up duration before reset  e.g. 1:00  = 1 minute

PITG_GPIO_OPTS="-p limitimer -u /dev/ttyLimitimer -b 19200 -i 250 -c 0 -t 10:00 -o 1:00"
